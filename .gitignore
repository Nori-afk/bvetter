# Environment & secrets
.env
config/connection.php
reset-links.log
*.log

# Composer binaries (install via: php -r "copy('https://getcomposer.org/installer', 'composer-setup.php');")
composer.phar
composer-setup.php

# Vendor (regenerated via: composer install)
# Uncomment the line below ONLY if you cannot run composer on the server
# vendor/

# Python cache
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Python virtualenv. Prod keeps one at /var/www/bvetter/.venv and the analytics
# systemd unit runs from it, so it must never be tracked.
.venv/
venv/

# PHPUnit cache
.phpunit.result.cache

# Database backups (contain real data — see database/backup.php)
database/backups/

# mPDF temp cache
tmp/

# User uploads (never commit real user data)
storage/

# Office lock files. Excel/Word write a "~$name.xlsx" stub beside a document
# while it is open and delete it on close, so one gets staged whenever the
# dataset workbook happens to be open during a `git add`.
~$*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Claude Code
.claude/
.playwright-mcp/
